{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/lib/**/*.js",
    "packages/*/schema/**/*.js",
    "packages/plugin/src/**/*.ts"
  ]
}
