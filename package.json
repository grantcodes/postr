{
  "private": true,
  "homepage": "https://github.com/grantcodes/postr",
  "bugs": "https://github.com/grantcodes/postr/issues",
  "license": "ISC",
  "author": "Grant Richmond <mail@grant.codes> (https://grant.codes)",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test-server": "node tests/server.ts",
    "check": "vp check && pnpm run build && pnpm run test && pnpm run check:packages",
    "check:packages": "pnpm -r exec publint --strict && pnpm -r exec attw --pack . --profile esm-only --no-summary"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@hono/node-server": "^2.1.6",
    "@types/node": "^24.19.2",
    "hono": "^4.13.16",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0"
}
