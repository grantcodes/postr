{
  "name": "@postr/core",
  "version": "1.10.3",
  "description": "A library-first Micropub server and content engine",
  "homepage": "https://github.com/grantcodes/postr",
  "bugs": "https://github.com/grantcodes/postr/issues",
  "license": "ISC",
  "author": "Grant Richmond <mail@grant.codes> (https://grant.codes)",
  "bin": {
    "postr-import-legacy": "./dist/bin/import-legacy.js"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@postr/source": "./src/index.ts",
