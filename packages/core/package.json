  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@sindresorhus/slugify": "^4.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "file-type": "^22.3.0",
    "hono": "^4.13.16",
    "linkedom": "^0.18.15",
    "marked": "^18.1.3",
    "microformats-parser": "^2.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "1.0.0-rc.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "sharp": "^0.34.0 || ^0.35.0"
  },
  "peerDependenciesMeta": {
